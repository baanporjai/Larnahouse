# คัดลอกไฟล์นี้เป็น widget.secrets.properties (ไฟล์นั้นถูก .gitignore ไว้แล้ว ห้าม commit ค่าจริง)
#
# WORKER_BASE_URL = โดเมนของ Cloudflare Worker "larnaapi" (ตัวเดียวกับที่ cloudflare-worker.js
#                    ถูก deploy อยู่ — ดู API_BASE ใน dashboard.html/machine-sales.html)
#                    (ไม่มี / ปิดท้าย)
# WIDGET_TOKEN     = ค่าเดียวกับ secret ที่ตั้งไว้บน Worker ด้วย
#                    `wrangler secret put WIDGET_TOKEN --name larnaapi`

WORKER_BASE_URL=https://larnaapi.yai-taweewoot.workers.dev
WIDGET_TOKEN=paste-the-same-value-you-put-in-wrangler-secret-here
